# Miscellaneous
*.class
*.log
# A recorded run's launcher log is part of the demo's recording.
!demo/fixture/run/*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Embedder: downloaded FlutterEmbedder.framework (see lib/src/embedder/)
/.engine/

# `/tool/catalog/demos/fixture_*.dart` used to be ignored here, so that a run
# killed halfway left an untracked file rather than a modified tracked one.
# It cannot be: discovery is gitignore-aware now, so an ignored demo is a demo
# the scan correctly refuses to see — and every test that writes a fixture and
# waits for the daemon to announce it waited forever. The fixtures are still
# written and deleted by the test; they are simply visible while they exist.

# Web related

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
